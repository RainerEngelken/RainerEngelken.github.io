<div class="instructor-notes">
    <h2>What this demo is meant to illustrate:</h2>
    <p>This interactive applet visualizes the mathematical foundation of the Dirac impulse and the sifting property, key concepts in ECE 210 (Analog Signal Processing).</p>
    
    <h3>Key Concepts Taught</h3>
    <ul>
        <li><strong>The Impulse as a Limit:</strong> By sliding the Pulse Width ($\epsilon$) to 0, students observe the rectangular pulse $p_\epsilon(t)$ getting narrower and taller. The visual reinforcement shows that the <em>area</em> remains constant at 1, converging to the ideal Dirac delta $\delta(t)$.</li>
        <li><strong>The Sifting Property:</strong> The integral of $f(t)\delta(t-t_0)$ "sifts" out the value of $f(t_0)$. The approximation integral physically calculates the <em>average height</em> of $f(t)$ across the pulse width.</li>
        <li><strong>Integration Limits Matter:</strong> A common student mistake is blindly applying $f(t_0)$ without checking limits. Dragging $t_0$ outside the shaded integration window $[a,b]$ instantly drops the integral to 0.</li>
    </ul>

    <h3>Addressed Misconceptions</h3>
    <ul>
        <li><em>"The impulse evaluates to infinity, so the integral blows up."</em> - The applet clearly distinguishes the height ($1/\epsilon$) from the area (1). The highlight of the overlap region maps to the actual numerical value.</li>
        <li><em>"Sifting works unconditionally."</em> - The live equation explicitly zeros out when $t_0$ exits the $[a,b]$ bounds, enforcing boundary awareness.</li>
        <li><em>"A real pulse behaves exactly like an impulse."</em> - Leaving $\epsilon &gt; 0$ shows the approximation error (difference between the top and bottom equations).</li>
    </ul>
    
    <p><strong>How to use:</strong> You can drag the vertical lines directly on the canvas to move $t_0$ (orange dashed line) or the limits $a$ and $b$ (blue dashed lines). Use "Challenge Mode" to test prediction skills without seeing the answer first.</p>
</div>

<script>
    // App State
    const state = {
        signal: 'cosine',
        epsilon: 0.5,
        t0: 1.0,
        a: -2.0,
        b: 3.0,
        isChallenge: false,
        dragTarget: null // 't0', 'a', or 'b'
    };

    // DOM Elements
    const canvas = document.getElementById('plotCanvas');
    const ctx = canvas.getContext('2d');
    
    const els = {
        signal: document.getElementById('signalType'),
        epsilon: document.getElementById('epsilon'),
        epsilonVal: document.getElementById('epsilonVal'),
        t0: document.getElementById('t0'),
        t0Val: document.getElementById('t0Val'),
        aLimit: document.getElementById('aLimit'),
        aVal: document.getElementById('aVal'),
        bLimit: document.getElementById('bLimit'),
        bVal: document.getElementById('bVal'),
        resApprox: document.getElementById('resApprox'),
        resExact: document.getElementById('resExact'),
        challengeBtn: document.getElementById('challengeBtn'),
        challengeBox: document.getElementById('challengeBox'),
        challengeInput: document.getElementById('challengeInput'),
        challengeFeedback: document.getElementById('challengeFeedback')
    };

    // Signal Definitions
    const signals = {
        'cosine': t => Math.cos(Math.PI * t / 2), // scaled for better view
        'triangle': t => Math.max(0, 2 - Math.abs(t)),
        'exp': t => t >= -1 ? 2*Math.exp(-(t+1)) : 0,
        'step': t => t >= 0 ? 1.5 : 0
    };

    // Initialization
    function init() {
        // Setup canvas resolution for sharp rendering
        const dpr = window.devicePixelRatio || 1;
        canvas.width = canvas.clientWidth * dpr;
        canvas.height = canvas.clientHeight * dpr;
        ctx.scale(dpr, dpr);

        // Attach listeners
        els.signal.addEventListener('change', e => { state.signal = e.target.value; update(); });
        els.epsilon.addEventListener('input', e => { state.epsilon = parseFloat(e.target.value); update(); });
        els.t0.addEventListener('input', e => { state.t0 = parseFloat(e.target.value); update(); });
        els.aLimit.addEventListener('input', e => { 
            state.a = parseFloat(e.target.value); 
            if(state.a > state.b) { state.b = state.a; els.bLimit.value = state.b; }
            update(); 
        });
        els.bLimit.addEventListener('input', e => { 
            state.b = parseFloat(e.target.value); 
            if(state.b < state.a) { state.a = state.b; els.aLimit.value = state.a; }
            update(); 
        });

        els.challengeBtn.addEventListener('click', toggleChallenge);

        // Mouse/Touch Events for Canvas
        canvas.addEventListener('mousedown', handlePointerDown);
        canvas.addEventListener('mousemove', handlePointerMove);
        canvas.addEventListener('mouseup', handlePointerUp);
        canvas.addEventListener('mouseleave', handlePointerUp);

        canvas.addEventListener('touchstart', handlePointerDown, {passive: false});
        canvas.addEventListener('touchmove', handlePointerMove, {passive: false});
        canvas.addEventListener('touchend', handlePointerUp);

        update();
    }

    // Mapping Functions (Math coordinates to Canvas pixels)
    const xMin = -5, xMax = 5;
    const yMin = -0.5, yMax = 3.5;
    
    function mapX(x) {
        return ((x - xMin) / (xMax - xMin)) * (canvas.width / (window.devicePixelRatio || 1));
    }
    
    function mapY(y) {
        const h = canvas.height / (window.devicePixelRatio || 1);
        return h - ((y - yMin) / (yMax - yMin)) * h;
    }

    function unmapX(px) {
        const w = canvas.width / (window.devicePixelRatio || 1);
        return xMin + (px / w) * (xMax - xMin);
    }

    // Math Functions
    function calculateExact() {
        const f = signals[state.signal];
        if (state.t0 >= state.a && state.t0 <= state.b) {
            return f(state.t0);
        }
        return 0;
    }

    function calculateApprox() {
        if (state.epsilon === 0) return calculateExact();
        
        const f = signals[state.signal];
        const pStart = state.t0 - state.epsilon / 2;
        const pEnd = state.t0 + state.epsilon / 2;
        
        const intStart = Math.max(state.a, pStart);
        const intEnd = Math.min(state.b, pEnd);

        if (intStart >= intEnd) return 0;

        // Numerical integration (Trapezoidal / fine Riemann sum)
        const steps = 100;
        const dx = (intEnd - intStart) / steps;
        let sum = 0;
        for (let i = 0; i < steps; i++) {
            const x = intStart + (i + 0.5) * dx;
            sum += f(x);
        }
        
        const area = sum * dx;
        return area * (1 / state.epsilon); // multiply by height of pulse
    }

    // Update Loop
    function update() {
        // Sync UI
        els.epsilonVal.innerHTML = state.epsilon === 0 ? "0 (Ideal &delta;)" : state.epsilon.toFixed(2);
        els.t0Val.innerText = state.t0.toFixed(1);
        els.aVal.innerText = state.a.toFixed(1);
        els.bVal.innerText = state.b.toFixed(1);

        els.epsilon.value = state.epsilon;
        els.t0.value = state.t0;
        els.aLimit.value = state.a;
        els.bLimit.value = state.b;

        draw();

        if (!state.isChallenge) {
            const exact = calculateExact();
            const approx = calculateApprox();
            els.resExact.innerText = exact.toFixed(3);
            els.resApprox.innerText = approx.toFixed(3);
            els.resExact.style.color = (state.t0 >= state.a && state.t0 <= state.b) ? 'var(--accent-blue)' : 'var(--text-muted)';
        } else {
            els.resExact.innerText = "?";
            els.resApprox.innerText = "?";
        }
    }

    // Canvas Drawing
    function draw() {
        const w = canvas.width / (window.devicePixelRatio || 1);
        const h = canvas.height / (window.devicePixelRatio || 1);
        
        ctx.clearRect(0, 0, w, h);

        // Draw Axes
        ctx.beginPath();
        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 1;
        // X axis
        ctx.moveTo(0, mapY(0));
        ctx.lineTo(w, mapY(0));
        // Y axis
        ctx.moveTo(mapX(0), 0);
        ctx.lineTo(mapX(0), h);
        ctx.stroke();

        // X-axis ticks
        ctx.fillStyle = '#64748b';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'center';
        for(let i = xMin; i <= xMax; i++) {
            if(i !== 0) {
                ctx.beginPath();
                ctx.moveTo(mapX(i), mapY(0) - 4);
                ctx.lineTo(mapX(i), mapY(0) + 4);
                ctx.stroke();
                ctx.fillText(i, mapX(i), mapY(0) + 16);
            }
        }

        // Draw Integration Window
        ctx.fillStyle = 'rgba(37, 99, 235, 0.08)';
        ctx.fillRect(mapX(state.a), 0, mapX(state.b) - mapX(state.a), h);
        
        ctx.strokeStyle = 'var(--accent-blue)';
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.moveTo(mapX(state.a), 0); ctx.lineTo(mapX(state.a), h);
        ctx.moveTo(mapX(state.b), 0); ctx.lineTo(mapX(state.b), h);
        ctx.stroke();
        ctx.setLineDash([]);

        // Draw Signal f(t)
        const f = signals[state.signal];
        ctx.strokeStyle = 'var(--accent-blue)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        for(let px = 0; px <= w; px += 2) {
            const x = unmapX(px);
            const y = f(x);
            if (px === 0) ctx.moveTo(px, mapY(y));
            else ctx.lineTo(px, mapY(y));
        }
        ctx.stroke();

        // Draw Pulse p_e(t)
        if (state.epsilon > 0) {
            const pStart = state.t0 - state.epsilon / 2;
            const pEnd = state.t0 + state.epsilon / 2;
            const pHeight = 1 / state.epsilon;
            
            // Draw box
            ctx.fillStyle = 'rgba(217, 119, 6, 0.2)';
            ctx.strokeStyle = 'var(--accent-orange)';
            ctx.lineWidth = 1.5;
            
            // Clip height visually so it doesn't break canvas entirely, but indicate it goes up
            const displayHeight = Math.min(pHeight, yMax - 0.2); 
            
            ctx.fillRect(mapX(pStart), mapY(displayHeight), mapX(pEnd) - mapX(pStart), mapY(0) - mapY(displayHeight));
            ctx.strokeRect(mapX(pStart), mapY(displayHeight), mapX(pEnd) - mapX(pStart), mapY(0) - mapY(displayHeight));
            
            // Highlight overlap with f(t) inside window
            const intStart = Math.max(state.a, pStart);
            const intEnd = Math.min(state.b, pEnd);
            
            if (intStart < intEnd) {
                ctx.fillStyle = 'rgba(22, 163, 74, 0.4)'; // Green overlap
                ctx.beginPath();
                ctx.moveTo(mapX(intStart), mapY(0));
                for(let x = intStart; x <= intEnd; x += 0.01) {
                    ctx.lineTo(mapX(x), mapY(f(x)));
                }
                ctx.lineTo(mapX(intEnd), mapY(0));
                ctx.fill();
            }

            // Height label
            ctx.fillStyle = 'var(--accent-orange)';
            ctx.fillText(`1/ε = ${pHeight.toFixed(1)}`, mapX(state.t0), mapY(displayHeight) - 8);

        } else {
            // Draw Ideal Dirac Arrow
            ctx.strokeStyle = 'var(--accent-orange)';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(mapX(state.t0), mapY(0));
            ctx.lineTo(mapX(state.t0), mapY(yMax - 0.5));
            ctx.stroke();
            
            // Arrowhead
            ctx.beginPath();
            ctx.moveTo(mapX(state.t0), mapY(yMax - 0.5) - 10);
            ctx.lineTo(mapX(state.t0) - 6, mapY(yMax - 0.5) + 2);
            ctx.lineTo(mapX(state.t0) + 6, mapY(yMax - 0.5) + 2);
            ctx.fillStyle = 'var(--accent-orange)';
            ctx.fill();

            // Label
            ctx.font = '16px serif';
            ctx.fillText('δ(t-t₀)', mapX(state.t0) + 25, mapY(yMax - 1));

            // Overlap point (if inside window)
            if (state.t0 >= state.a && state.t0 <= state.b) {
                ctx.beginPath();
                ctx.arc(mapX(state.t0), mapY(f(state.t0)), 5, 0, 2*Math.PI);
                ctx.fillStyle = 'var(--accent-green)';
                ctx.fill();
                ctx.stroke();
            }
        }

        // Draw t0 handle line
        ctx.strokeStyle = 'var(--accent-orange)';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(mapX(state.t0), mapY(0));
        ctx.lineTo(mapX(state.t0), h);
        ctx.stroke();
        ctx.setLineDash([]);
        
        // Handles for grabbing
        drawHandle(mapX(state.a), mapY(-0.25), 'a', 'var(--accent-blue)');
        drawHandle(mapX(state.b), mapY(-0.25), 'b', 'var(--accent-blue)');
        drawHandle(mapX(state.t0), mapY(-0.25), 't₀', 'var(--accent-orange)');
    }

    function drawHandle(px, py, label, color) {
        ctx.beginPath();
        ctx.arc(px, py, 8, 0, 2*Math.PI);
        ctx.fillStyle = color;
        ctx.fill();
        ctx.fillStyle = 'white';
        ctx.font = '10px sans-serif';
        ctx.fillText(label, px, py + 3);
    }

    // Pointer Dragging Logic
    function getPointerPos(e) {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const px = clientX - rect.left;
        return unmapX(px);
    }

    function handlePointerDown(e) {
        e.preventDefault();
        const x = getPointerPos(e);
        const sensitivity = 0.4;

        // Determine which handle is closest
        const distA = Math.abs(x - state.a);
        const distB = Math.abs(x - state.b);
        const distT0 = Math.abs(x - state.t0);

        const minDist = Math.min(distA, distB, distT0);

        if (minDist > sensitivity) return; // missed all

        if (minDist === distT0) state.dragTarget = 't0';
        else if (minDist === distA) state.dragTarget = 'a';
        else if (minDist === distB) state.dragTarget = 'b';
    }

    function handlePointerMove(e) {
        if (!state.dragTarget) return;
        e.preventDefault();
        
        let x = getPointerPos(e);
        x = Math.max(xMin, Math.min(xMax, x)); // clamp
        x = Math.round(x * 20) / 20; // snap to 0.05

        if (state.dragTarget === 't0') {
            state.t0 = x;
        } else if (state.dragTarget === 'a') {
            state.a = Math.min(x, state.b);
        } else if (state.dragTarget === 'b') {
            state.b = Math.max(x, state.a);
        }
        
        update();
    }

    function handlePointerUp(e) {
        state.dragTarget = null;
    }

    // Presets and Challenge Logic
    window.loadPreset = function(type) {
        state.isChallenge = false;
        els.challengeBox.classList.remove('active');
        els.challengeBtn.innerText = "Enter Challenge Mode";
        els.challengeFeedback.innerText = "";

        if (type === 'sifting') {
            state.signal = 'cosine'; state.epsilon = 0; state.t0 = 1; state.a = -2; state.b = 3;
        } else if (type === 'outside') {
            state.signal = 'triangle'; state.epsilon = 0.2; state.t0 = -3; state.a = -1; state.b = 3;
        } else if (type === 'approx') {
            state.signal = 'exp'; state.epsilon = 1.5; state.t0 = 0.5; state.a = 0; state.b = 4;
        } else if (type === 'boundary') {
            state.signal = 'cosine'; state.epsilon = 0; state.t0 = 2; state.a = -2; state.b = 2;
        }
        update();
    };

    function toggleChallenge() {
        state.isChallenge = !state.isChallenge;
        els.challengeFeedback.innerText = "";
        els.challengeInput.value = "";
        
        if (state.isChallenge) {
            els.challengeBox.classList.add('active');
            els.challengeBtn.innerText = "Exit Challenge Mode";
            
            // Randomize state
            const sigs = Object.keys(signals);
            state.signal = sigs[Math.floor(Math.random() * sigs.length)];
            state.epsilon = 0; // Test ideal delta
            state.a = Math.floor(Math.random() * 6) - 3;
            state.b = state.a + Math.floor(Math.random() * 4) + 1;
            
            // 30% chance to place t0 outside window to test limits misconception
            if (Math.random() > 0.7) {
                state.t0 = state.a - 1;
            } else {
                state.t0 = state.a + (Math.floor(Math.random() * (state.b - state.a + 1) * 2) / 2);
            }
        } else {
            els.challengeBox.classList.remove('active');
            els.challengeBtn.innerText = "Enter Challenge Mode";
        }
        update();
    }

    window.checkChallenge = function() {
        const userVal = parseFloat(els.challengeInput.value);
        if (isNaN(userVal)) return;

        const exact = calculateExact();
        
        if (Math.abs(userVal - exact) < 0.05) {
            els.challengeFeedback.innerText = "Correct! Well done.";
            els.challengeFeedback.className = "feedback correct";
            // Reveal answer
            state.isChallenge = false;
            update();
            setTimeout(() => { toggleChallenge(); }, 2000); // next challenge
        } else {
            els.challengeFeedback.innerText = "Incorrect. Check your integration limits!";
            els.challengeFeedback.className = "feedback incorrect";
            if (state.t0 < state.a || state.t0 > state.b) {
                els.challengeFeedback.innerText += " Notice where t₀ is relative to [a,b].";
            }
        }
    };

    // Run
    init();

</script>

</body></html>
